---
/**
 * "How I'm wired": Ryan's own assessment results, drawn as diagrams.
 * Working Genius: Invention + Tenacity ("The Methodical Architect").
 * Kolbe A Index: 8-4-8-1, "Maverick" (Fact Finder, Follow Thru, Quick Start, Implementor).
 */
const geniuses = [
  { name: 'Wonder', on: false },
  { name: 'Invention', on: true },
  { name: 'Discernment', on: false },
  { name: 'Galvanizing', on: false },
  { name: 'Enablement', on: false },
  { name: 'Tenacity', on: true },
];
const kolbe = [
  { mode: 'Fact Finder', score: 8, note: 'Gathers the detail and context before deciding' },
  { mode: 'Follow Thru', score: 4, note: 'Adapts structure to the situation' },
  { mode: 'Quick Start', score: 8, note: 'Experiments, improvises, starts things' },
  { mode: 'Implementor', score: 1, note: 'Works through ideas and people, not hand tools' },
];
// Six-segment ring
const cx = 110, cy = 110, R1 = 96, R2 = 58;
const seg = (i: number) => {
  const a0 = (-90 + i * 60 + 2) * Math.PI / 180, a1 = (-90 + (i + 1) * 60 - 2) * Math.PI / 180;
  const p = (r: number, a: number) => `${(cx + r * Math.cos(a)).toFixed(1)},${(cy + r * Math.sin(a)).toFixed(1)}`;
  return `M${p(R1, a0)} A${R1},${R1} 0 0 1 ${p(R1, a1)} L${p(R2, a1)} A${R2},${R2} 0 0 0 ${p(R2, a0)} Z`;
};
const labelPos = (i: number) => {
  const a = (-90 + i * 60 + 30) * Math.PI / 180;
  return { x: cx + 77 * Math.cos(a), y: cy + 77 * Math.sin(a) };
};
---
<div class="wired">
  <figure class="card">
    <svg viewBox="0 0 220 220" role="img" aria-label="Working Genius: Invention and Tenacity highlighted among the six geniuses">
      {geniuses.map((g, i) => (
        <path d={seg(i)} class:list={['seg', { on: g.on }]} />
      ))}
      {geniuses.map((g, i) => {
        const p = labelPos(i);
        return <text x={p.x} y={p.y + 4} text-anchor="middle" class:list={['gl', { on: g.on }]}>{g.name.slice(0, 1)}</text>;
      })}
      <text x={cx} y={cy - 2} text-anchor="middle" class="core">Methodical</text>
      <text x={cx} y={cy + 16} text-anchor="middle" class="core">Architect</text>
    </svg>
    <figcaption>
      <h3>Working Genius</h3>
      <p><strong>Invention</strong> and <strong>Tenacity</strong>: I come up with the new idea, then I’m the one who sees it all the way through to done.</p>
    </figcaption>
  </figure>

  <figure class="card">
    <div class="kolbe" role="img" aria-label="Kolbe A Index 8-4-8-1: Fact Finder 8, Follow Thru 4, Quick Start 8, Implementor 1">
      {kolbe.map((k) => (
        <div class="k">
          <span class="k-name">{k.mode}</span>
          <span class="k-bar" aria-hidden="true">
            {Array.from({ length: 10 }, (_, i) => <i class:list={{ on: i < k.score }}></i>)}
          </span>
          <span class="k-score">{k.score}</span>
        </div>
      ))}
    </div>
    <figcaption>
      <h3>Kolbe: Maverick, 8-4-8-1</h3>
      <p>High Fact Finder and high Quick Start: I dig into the details, then move fast and try things. That’s the research-then-prototype rhythm behind everything on this site.</p>
    </figcaption>
  </figure>
</div>

<style>
  .wired { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.25rem; }
  .card { margin: 0; background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); padding: 1.75rem; display: grid; grid-template-columns: 11rem 1fr; gap: 1.5rem; align-items: center; }
  svg { width: 100%; height: auto; }
  .seg { fill: color-mix(in srgb, var(--line) 70%, transparent); }
  .seg.on { fill: var(--stage); }
  .gl { font: 700 13px var(--display); fill: var(--muted); }
  .gl.on { fill: var(--stage-ink); }
  .core { font: 700 12.5px var(--display); fill: var(--text); }
  h3 { margin: 0 0 0.4rem; }
  figcaption p { margin: 0; color: var(--muted); }
  figcaption strong { color: var(--text); }
  .kolbe { display: grid; gap: 0.7rem; }
  .k { display: grid; grid-template-columns: 1fr; gap: 0.25rem; }
  .k-name { font-size: 0.8rem; font-weight: 600; color: var(--muted); }
  .k-bar { display: grid; grid-template-columns: repeat(10, 1fr); gap: 2px; grid-column: 1; }
  .k-bar i { height: 0.6rem; border-radius: 2px; background: color-mix(in srgb, var(--line) 80%, transparent); }
  .k-bar i.on { background: var(--stage); }
  .k-score { display: none; }
  @media (prefers-color-scheme: dark) { .seg.on, .k-bar i.on { fill: var(--stage-muted); background: var(--stage-muted); } .gl.on { fill: var(--stage); } }
  @media (max-width: 60rem) { .wired { grid-template-columns: 1fr; } }
  @media (max-width: 30rem) { .card { grid-template-columns: 1fr; } svg, .kolbe { max-width: 12rem; } }
</style>
