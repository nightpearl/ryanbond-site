---
interface Props {
  slug: string;
  title: string;
  kicker: string;
  years: string;
  summary: string;
  cover?: string;
}
const { slug, title, kicker, years, summary, cover } = Astro.props;
---
<a class="story" href={`/work/${slug}/`}>
  <div class="thumb">
    {cover
      ? <img src={cover} alt="" loading="lazy" />
      : <span class="mono" aria-hidden="true">{title}</span>}
  </div>
  <div class="body">
    <p class="kicker">{kicker} · {years}</p>
    <h3>{title}</h3>
    <p class="summary">{summary}</p>
    <span class="more">Read the story →</span>
  </div>
</a>

<style>
  .story {
    display: flex; flex-direction: column; text-decoration: none; color: var(--text);
    background: var(--surface); border: 1px solid var(--line); border-radius: 1rem; overflow: hidden;
    transition: transform 0.15s ease, border-color 0.15s ease;
  }
  .story:hover { transform: translateY(-2px); border-color: var(--accent); }
  .thumb { aspect-ratio: 16 / 9; background: var(--line); overflow: hidden; display: flex; align-items: flex-end; }
  .thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .mono {
    width: 100%; height: 100%; display: flex; align-items: flex-end; padding: 1.25rem;
    background: linear-gradient(135deg, var(--accent), color-mix(in srgb, var(--accent) 55%, var(--text)));
    color: #fff; font-family: var(--serif); font-weight: 700; font-size: 1.6rem; line-height: 1.1;
  }
  .body { padding: 1.1rem 1.25rem 1.35rem; display: flex; flex-direction: column; gap: 0.4rem; flex: 1; }
  .kicker { margin: 0; font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.06em; font-weight: 600; color: var(--accent); }
  h3 { margin: 0; font-size: 1.3rem; }
  .summary { margin: 0; color: var(--muted); font-size: 0.95rem; line-height: 1.5; flex: 1; }
  .more { font-weight: 600; color: var(--accent); font-size: 0.9rem; margin-top: 0.4rem; }
</style>
