---
// The product loop: insight → prototype → validate → ship → back to insight.
const steps = [
  { label: 'Customer insight', sub: 'Who is it for, and what do they need?' },
  { label: 'Prototype', sub: 'Make it real enough to react to' },
  { label: 'Validate', sub: 'Put it in front of real people' },
  { label: 'Ship & learn', sub: 'Release, measure, repeat' },
];
const cx = 200, cy = 200, R = 132;
const pos = steps.map((_, i) => {
  const a = -Math.PI / 2 + (i * Math.PI) / 2;
  return { x: cx + Math.cos(a) * R, y: cy + Math.sin(a) * R };
});
// arc segments between nodes with gap
const arc = (i: number) => {
  const a0 = -Math.PI / 2 + (i * Math.PI) / 2 + 0.32;
  const a1 = -Math.PI / 2 + ((i + 1) * Math.PI) / 2 - 0.32;
  const p0 = { x: cx + Math.cos(a0) * R, y: cy + Math.sin(a0) * R };
  const p1 = { x: cx + Math.cos(a1) * R, y: cy + Math.sin(a1) * R };
  return `M${p0.x.toFixed(1)},${p0.y.toFixed(1)} A${R},${R} 0 0 1 ${p1.x.toFixed(1)},${p1.y.toFixed(1)}`;
};
---
<figure class="loop">
  <svg viewBox="0 0 400 400" role="img" aria-labelledby="loop-title">
    <title id="loop-title">The product loop: customer insight, prototype, validate, ship and learn, then back to insight.</title>
    <defs>
      <marker id="arrowhead" viewBox="0 0 10 10" refX="7" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M0,0 L10,5 L0,10 z" fill="var(--pine)" />
      </marker>
    </defs>
    <circle cx={cx} cy={cy} r={R} fill="none" stroke="var(--contour)" stroke-width="22" />
    {steps.map((_, i) => <path d={arc(i)} fill="none" stroke="var(--pine)" stroke-width="2.5" marker-end="url(#arrowhead)" />)}
    {pos.map((p, i) => (
      <g>
        <circle cx={p.x} cy={p.y} r="21" fill="var(--paper)" stroke="var(--pine)" stroke-width="2.5" />
        <text x={p.x} y={p.y + 6} text-anchor="middle" class="n">{i + 1}</text>
      </g>
    ))}
    <text x={cx} y={cy - 8} text-anchor="middle" class="core">Faster laps,</text>
    <text x={cx} y={cy + 18} text-anchor="middle" class="core">same judgment</text>
  </svg>
  <ol class="legend">
    {steps.map((s) => <li><strong>{s.label}</strong><span>{s.sub}</span></li>)}
  </ol>
</figure>

<style>
  .loop { margin: 0; display: grid; grid-template-columns: minmax(12rem, 18rem) minmax(13rem, 1fr); gap: 2rem; align-items: center; }
  svg { width: 100%; height: auto; }
  .n { font-family: var(--display); font-weight: 700; font-size: 18px; fill: var(--pine); }
  .core { font-family: var(--display); font-weight: 700; font-size: 20px; fill: var(--ink); }
  .legend { margin: 0; padding-left: 1.4rem; display: grid; gap: 0.9rem; }
  .legend li::marker { font-weight: 700; color: var(--pine); }
  .legend strong { display: block; font-size: 1.1rem; }
  .legend span { color: var(--muted); }
  @media (max-width: 44rem) { .loop { grid-template-columns: 1fr; } svg { max-width: 18rem; margin: 0 auto; } }
</style>
