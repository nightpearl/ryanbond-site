---
import TopoMap from './TopoMap.astro';
interface Props {
  slug: string;
  title: string;
  kicker: string;
  years: string;
  summary: string;
  cover?: string;
  highlight?: string;
  seed?: number;
}
const { slug, title, kicker, years, summary, cover, highlight, seed = 3 } = Astro.props;
---
<article class="row">
  <a class="media" href={`/work/${slug}/`} tabindex="-1" aria-hidden="true">
    {cover ? <img src={cover} alt="" loading="lazy" /> : <TopoMap seed={seed} width={480} height={300} rings={8} />}
  </a>
  <div class="text">
    <p class="meta"><span>{kicker}</span><span>{years}</span></p>
    <h3><a href={`/work/${slug}/`}>{title}</a></h3>
    <p class="summary">{summary}</p>
    {highlight && <p class="highlight">{highlight}</p>}
  </div>
</article>

<style>
  .row { display: grid; grid-template-columns: 18rem 1fr; gap: 2rem; padding: 2rem 0; border-top: 1px solid var(--line); align-items: start; }
  .media { display: block; aspect-ratio: 16 / 10; border-radius: 6px; overflow: hidden; background: var(--surface); border: 1px solid var(--line); }
  .media img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .meta { display: flex; flex-wrap: wrap; gap: 0.25rem 1rem; margin: 0 0 0.4rem; font-size: 0.95rem; color: var(--muted); }
  .meta span:first-child { color: var(--accent); font-weight: 600; }
  h3 { font-size: 1.55rem; margin: 0 0 0.5rem; }
  h3 a { color: var(--text); text-decoration: none; }
  h3 a:hover { text-decoration: underline; text-decoration-color: var(--blaze); text-decoration-thickness: 3px; }
  .summary { font-family: var(--reading); font-size: 1.1rem; color: var(--muted); margin: 0 0 0.75rem; max-width: 38rem; }
  .highlight { margin: 0; font-weight: 600; padding-left: 0.75rem; border-left: 3px solid var(--blaze); }
  @media (max-width: 44rem) { .row { grid-template-columns: 1fr; gap: 1rem; } }
</style>
