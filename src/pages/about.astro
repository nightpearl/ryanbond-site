---
import Base from '../layouts/Base.astro';
import CareerTimeline from '../components/CareerTimeline.astro';

const community = [
  { title: 'Scouting America', body: 'Eagle Scout and Wood Badge recipient. Fifteen-plus years as a Cubmaster, Scoutmaster and District Committee Member, and producer of council video campaigns.' },
  { title: 'Theatre', body: 'Board of Directors for Otherworld Theatre and WildClaw Theatre, advisory committee for Skokie Devonshire Playhouse, and producer, stage manager and actor on North Shore stages.' },
  { title: 'Speaking & teaching', body: 'SXSW 2019 speaker. Industry sponsor for classes at Northwestern University and Columbia College Chicago.' },
  { title: 'Education', body: 'BFA in Digital Arts from the University of Arizona: multimedia, animation, 3D design and programming.' },
];
const headshot = 'https://skillpointstation.wordpress.com/wp-content/uploads/2024/11/ryan-bond-small-headshot-2024.jpg?w=800';
---
<Base title="About | Ryan Bond" description="Ryan Bond: product leader, producer, Scout leader and theatre maker, based in Evanston, Illinois.">
  <section class="intro">
    <div>
      <p class="kicker">About</p>
      <h1>I turn ambiguity into things people use.</h1>
      <p class="lede">
        I’m a product leader and producer in Evanston, Illinois. Over 25 years I’ve led product
        at Encyclopaedia Britannica and SteelSeries, run Fortune 500 programs at Razorfish,
        produced more than 150 games, and helped health and AI startups find their footing.
      </p>
      <p class="reading body">
        The thread through all of it is the same: start with the people you’re serving, test early,
        and keep teams pointed at outcomes. AI tools now let me go from customer insight to a working
        prototype in days. The judgment about what’s worth building still comes from experience.
      </p>
    </div>
    <img src={headshot} alt="Ryan Bond" />
  </section>

  <section class="block">
    <h2>Twenty-five years, to scale</h2>
    <CareerTimeline />
    <p class="note">Full resume on request, or see <a href="https://www.linkedin.com/in/ryanmbond/">LinkedIn</a>. My longer <a href="/approach/">product philosophy</a> is here too.</p>
  </section>

  <section class="block ai">
    <div>
      <h2>How I use AI</h2>
      <p class="reading body">
        I use Claude, ChatGPT, Gemini, Figma Make, Lovable and agentic workflows to speed up discovery
        and prototyping: synthesizing interviews, drafting user stories, and building clickable concepts
        to test with real users. AI does the drafting. Decisions, and the accountability for them,
        stay with people. This site is built and maintained the same way.
      </p>
    </div>
    <dl class="split">
      <div><dt>AI handles</dt><dd>Interview synthesis, first-draft stories and specs, clickable prototypes, research sweeps</dd></div>
      <div><dt>I own</dt><dd>Which problem to solve, for whom, what not to build, and the call when the data is imperfect</dd></div>
    </dl>
  </section>

  <section class="block">
    <h2>Beyond the day job</h2>
    <div class="community">
      {community.map((c) => (<div><h3>{c.title}</h3><p>{c.body}</p></div>))}
    </div>
  </section>
</Base>

<style>
  .intro { display: grid; grid-template-columns: 1fr 17rem; gap: 3rem; align-items: start; padding: 3.5rem 0 2rem; }
  .intro h1 { max-width: 14ch; }
  .intro img { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; border-radius: 8px; background: var(--surface); }
  .body { font-size: 1.15rem; line-height: 1.7; max-width: var(--measure); }
  .block { border-top: 1px solid var(--line); padding: 3rem 0; }
  .note { color: var(--muted); margin-top: 1.5rem; }
  .ai { display: grid; grid-template-columns: 1.2fr 1fr; gap: 2.5rem; align-items: start; }
  .split { margin: 0; display: grid; gap: 1rem; }
  .split div { background: var(--surface); border-left: 4px solid var(--pine); padding: 1rem 1.25rem; border-radius: 4px; }
  .split div + div { border-left-color: var(--blaze); }
  .split dt { font-weight: 700; margin-bottom: 0.25rem; }
  .split dd { margin: 0; color: var(--muted); }
  .community { display: grid; grid-template-columns: repeat(2, 1fr); gap: 2rem 2.5rem; }
  .community h3 { margin-bottom: 0.35rem; }
  .community p { color: var(--muted); font-family: var(--reading); font-size: 1.08rem; margin: 0; }
  @media (max-width: 48rem) {
    .intro, .ai, .community { grid-template-columns: 1fr; }
    .intro img { max-width: 14rem; grid-row: 1; }
  }
</style>
