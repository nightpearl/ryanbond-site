---
import Base from '../../layouts/Base.astro';
import StoryRow from '../../components/StoryRow.astro';
import { getCollection } from 'astro:content';

const stories = (await getCollection('stories')).sort((a, b) => a.data.order - b.data.order);
const archive = (await getCollection('work')).sort((a, b) => {
  const start = (y: string) => parseInt(y, 10);
  return start(b.data.years) - start(a.data.years) || a.data.order - b.data.order;
});
---
<Base title="Work | Ryan Bond" description="Featured stories and a 25-year archive of product, game and campaign work by Ryan Bond.">
  <header class="page-head">
    <p class="kicker">Work</p>
    <h1>Twenty-five years of building things people use</h1>
    <p class="lede">Six stories that show how I work, followed by the full archive of individual projects.</p>
  </header>

  <section aria-labelledby="stories-h">
    <h2 id="stories-h" class="visually-hidden">Featured stories</h2>
    {stories.map((s, i) => (
      <StoryRow slug={s.id} title={s.data.title} kicker={s.data.kicker} years={s.data.years}
        summary={s.data.summary} cover={s.data.cover} highlight={s.data.highlights[0]} seed={i * 7 + 3} />
    ))}
  </section>

  <section class="archive" aria-labelledby="archive-h">
    <h2 id="archive-h">The archive</h2>
    <p class="sub">Individual projects, newest first.</p>
    <ul>
      {archive.map((p) => (
        <li>
          <a href={`/work/${p.id}/`}>
            <span class="yrs">{p.data.years}</span>
            <span class="t">{p.data.title}</span>
            <span class="r">{p.data.role}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>
</Base>

<style>
  .page-head { padding: 3.5rem 0 1.5rem; }
  .page-head h1 { max-width: 18ch; }
  .visually-hidden { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
  .archive { border-top: 2px solid var(--text); margin-top: 3rem; padding-top: 2rem; }
  .sub { color: var(--muted); }
  .archive ul { list-style: none; margin: 0; padding: 0; }
  .archive a {
    display: grid; grid-template-columns: 7rem 1fr 1fr; gap: 0.15rem 1.5rem; padding: 0.9rem 0.5rem;
    border-bottom: 1px solid var(--line); text-decoration: none; color: var(--text); align-items: baseline;
  }
  .archive a:hover { background: var(--surface); }
  .yrs { color: var(--accent); font-weight: 600; font-size: 0.95rem; }
  .t { font-weight: 600; }
  .r { color: var(--muted); font-size: 0.95rem; }
  @media (max-width: 44rem) { .archive a { grid-template-columns: 1fr; } }
</style>
