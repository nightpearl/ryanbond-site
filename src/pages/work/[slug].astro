---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const stories = (await getCollection('stories')).sort((a, b) => a.data.order - b.data.order);
  const projects = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
  const storyPaths = stories.map((entry, i) => ({
    params: { slug: entry.id },
    props: { kind: 'story', entry, next: stories[(i + 1) % stories.length], projects },
  }));
  const projectPaths = projects.map((entry, i) => ({
    params: { slug: entry.id },
    props: { kind: 'project', entry, next: projects[(i + 1) % projects.length], projects },
  }));
  return [...storyPaths, ...projectPaths];
}

const { kind, entry, next, projects } = Astro.props as any;
const { Content } = await render(entry);
const d = entry.data;
const facts = kind === 'project'
  ? [['Role', d.role], ['Client', d.client], ['Product', d.product], ['Years', d.years], ['Type', d.type], ['Partners', d.agencies]].filter(([, v]) => v)
  : [];
const related = kind === 'story'
  ? d.related.map((id: string) => projects.find((p: any) => p.id === id)).filter(Boolean)
  : [];
---
<Base title={`${d.title} | Ryan Bond`} description={d.summary}>
  <article>
    <a class="back" href="/work/">← All work</a>
    <header>
      <p class="eyebrow">{kind === 'story' ? `${d.kicker} · ${d.years}` : d.years}</p>
      <h1>{d.title}</h1>
      {kind === 'story' && <p class="lede">{d.summary}</p>}
    </header>

    {d.cover && <img class="cover" src={d.cover} alt="" />}

    {kind === 'story' && (
      <div class="story-meta">
        <ul class="highlights">
          {d.highlights.map((h: string) => <li>{h}</li>)}
        </ul>
        <p class="roles"><span>Roles</span> {d.roles.join(' · ')}</p>
      </div>
    )}

    {kind === 'project' && (
      <dl class="facts">
        {facts.map(([k, v]) => (<div><dt>{k}</dt><dd>{v}</dd></div>))}
      </dl>
    )}
    {d.comingSoon && <p class="coming">The full write-up for this project is coming soon.</p>}

    <div class="prose"><Content /></div>

    {related.length > 0 && (
      <section class="related">
        <h2>Projects from this chapter</h2>
        <ul>
          {related.map((p: any) => (
            <li><a href={`/work/${p.id}/`}><strong>{p.data.title}</strong><span>{p.data.years}</span></a></li>
          ))}
        </ul>
      </section>
    )}

    <nav class="next">
      <span>{kind === 'story' ? 'Next story' : 'Next project'}</span>
      <a href={`/work/${next.id}/`}>{next.data.title} →</a>
    </nav>
  </article>
</Base>

<style>
  article { max-width: 46rem; margin: 0 auto; padding: 2rem 0; }
  .back { display: inline-block; margin-bottom: 1.5rem; text-decoration: none; font-weight: 600; }
  .eyebrow { color: var(--accent); font-weight: 600; margin: 0 0 0.5rem; text-transform: uppercase; letter-spacing: 0.06em; font-size: 0.8rem; }
  h1 { font-size: clamp(2rem, 6vw, 3rem); }
  .lede { color: var(--muted); font-size: 1.2rem; margin: 0 0 1rem; }
  .cover { width: 100%; border-radius: 1rem; border: 1px solid var(--line); margin: 1rem 0 1.5rem; display: block; }
  .story-meta { background: var(--surface); border: 1px solid var(--line); border-radius: 1rem; padding: 1.25rem; margin: 1rem 0 2rem; }
  .highlights { list-style: none; padding: 0; margin: 0 0 1rem; display: grid; gap: 0.6rem; }
  .highlights li { font-family: var(--serif); font-size: 1.15rem; font-weight: 700; padding-left: 1rem; border-left: 3px solid var(--accent); }
  .roles { margin: 0; color: var(--muted); font-size: 0.95rem; }
  .roles span { font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.06em; font-weight: 600; margin-right: 0.4rem; }
  .facts {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr)); gap: 1rem 1.5rem;
    background: var(--surface); border: 1px solid var(--line); border-radius: 1rem; padding: 1.25rem; margin: 0 0 2rem;
  }
  .facts dt { font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.06em; color: var(--muted); font-weight: 600; }
  .facts dd { margin: 0.2rem 0 0; }
  .coming { color: var(--muted); font-style: italic; }
  .related { border-top: 1px solid var(--line); margin-top: 2.5rem; padding-top: 1.5rem; }
  .related h2 { font-size: 1.3rem; }
  .related ul { list-style: none; padding: 0; margin: 0; }
  .related a { display: flex; justify-content: space-between; gap: 1rem; padding: 0.7rem 0; border-bottom: 1px solid var(--line); text-decoration: none; color: var(--text); }
  .related a span { color: var(--muted); font-size: 0.9rem; white-space: nowrap; }
  .next { border-top: 1px solid var(--line); margin-top: 3rem; padding-top: 1.5rem; display: flex; flex-direction: column; gap: 0.25rem; }
  .next span { color: var(--muted); font-size: 0.85rem; }
  .next a { font-family: var(--serif); font-size: 1.4rem; font-weight: 700; text-decoration: none; }
</style>
