---
import Base from '../../layouts/Base.astro';
import TopoMap from '../../components/TopoMap.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const stories = (await getCollection('stories')).sort((a, b) => a.data.order - b.data.order);
  const projects = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
  const storyPaths = stories.map((entry, i) => ({
    params: { slug: entry.id },
    props: { kind: 'story', entry, index: i, next: stories[(i + 1) % stories.length], projects },
  }));
  const projectPaths = projects.map((entry, i) => ({
    params: { slug: entry.id },
    props: { kind: 'project', entry, index: i, next: projects[(i + 1) % projects.length], projects },
  }));
  return [...storyPaths, ...projectPaths];
}

const { kind, entry, index, next, projects } = Astro.props as any;
const { Content } = await render(entry);
const d = entry.data;
const facts = kind === 'project'
  ? [['Role', d.role], ['Client', d.client], ['Product', d.product], ['Years', d.years], ['Type', d.type], ['Partners', d.agencies]].filter(([, v]) => v)
  : [];
const related = kind === 'story'
  ? d.related.map((id: string) => projects.find((p: any) => p.id === id)).filter(Boolean)
  : [];
---
<Base title={`${d.title} | Ryan Bond`} description={d.summary}>
  <article>
    <a class="back" href="/work/">All work</a>
    <header class="head">
      <p class="kicker">{kind === 'story' ? <>{d.kicker}<span class="yrs">{d.years}</span></> : d.years}</p>
      <h1>{d.title}</h1>
      {kind === 'story' && <p class="lede">{d.summary}</p>}
    </header>

    <div class="cover">
      {d.cover ? <img src={d.cover} alt="" /> : <TopoMap seed={index * 7 + 3} width={900} height={420} rings={9} />}
    </div>

    {kind === 'story' && (
      <div class="story-meta">
        <ul class="highlights">
          {d.highlights.map((h: string) => <li>{h}</li>)}
        </ul>
        <p class="roles"><strong>Roles:</strong> {d.roles.join(', ')}</p>
      </div>
    )}

    {kind === 'project' && (
      <dl class="facts">
        {facts.map(([k, v]) => (<div><dt>{k}</dt><dd>{v}</dd></div>))}
      </dl>
    )}
    {d.comingSoon && <p class="coming">The full write-up for this project is coming soon.</p>}

    <div class="prose"><Content /></div>

    {related.length > 0 && (
      <section class="related">
        <h2>Projects from this chapter</h2>
        <ul>
          {related.map((p: any) => (
            <li><a href={`/work/${p.id}/`}><strong>{p.data.title}</strong><span>{p.data.years}</span></a></li>
          ))}
        </ul>
      </section>
    )}

    <nav class="next" aria-label="Next">
      <span>{kind === 'story' ? 'Next story' : 'Next project'}</span>
      <a href={`/work/${next.id}/`}>{next.data.title}</a>
    </nav>
  </article>
</Base>

<style>
  article { padding: 2rem 0; }
  .back { display: inline-block; margin-bottom: 1.5rem; font-weight: 600; }
  .head { max-width: 50rem; }
  .yrs { color: var(--muted); font-weight: 500; margin-left: 0.75rem; padding-left: 0.75rem; border-left: 1px solid var(--line); }
  .cover { aspect-ratio: 21 / 9; border-radius: 8px; overflow: hidden; background: var(--surface); border: 1px solid var(--line); margin: 1.5rem 0 2rem; }
  .cover img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .story-meta { margin: 0 0 2.5rem; border-top: 2px solid var(--text); }
  .highlights { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(3, 1fr); }
  .highlights li { padding: 1.1rem 1.25rem 1.1rem 0; font-size: 1.1rem; font-weight: 700; line-height: 1.3; letter-spacing: -0.01em; }
  .highlights li + li { padding-left: 1.25rem; border-left: 1px solid var(--line); }
  .roles { margin: 0; padding-top: 0.9rem; border-top: 1px solid var(--line); color: var(--muted); }
  .roles strong { color: var(--text); }
  .facts {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr)); gap: 1rem 1.5rem;
    border-top: 2px solid var(--text); padding: 1.1rem 0; margin: 0 0 2rem;
  }
  .facts dt { font-size: 0.9rem; color: var(--muted); font-weight: 600; }
  .facts dd { margin: 0.15rem 0 0; }
  .coming { color: var(--muted); font-style: italic; }
  .related { border-top: 1px solid var(--line); margin-top: 3rem; padding-top: 1.5rem; max-width: var(--measure); }
  .related h2 { font-size: 1.3rem; }
  .related ul { list-style: none; padding: 0; margin: 0; }
  .related a { display: flex; justify-content: space-between; gap: 1rem; padding: 0.75rem 0; border-bottom: 1px solid var(--line); text-decoration: none; color: var(--text); }
  .related a:hover strong { color: var(--accent); }
  .related a span { color: var(--muted); font-size: 0.9rem; white-space: nowrap; }
  .next { border-top: 2px solid var(--text); margin-top: 3.5rem; padding-top: 1.5rem; display: flex; flex-direction: column; gap: 0.25rem; }
  .next span { color: var(--muted); font-size: 0.95rem; }
  .next a { font-size: clamp(1.4rem, 3vw, 1.9rem); font-weight: 700; letter-spacing: -0.02em; color: var(--text); text-decoration-color: var(--blaze); text-decoration-thickness: 3px; }
  @media (max-width: 44rem) {
    .highlights { grid-template-columns: 1fr; }
    .highlights li + li { padding-left: 0; border-left: 0; border-top: 1px solid var(--line); }
    .cover { aspect-ratio: 16 / 10; }
  }
</style>
