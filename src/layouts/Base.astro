---
interface Props {
  title?: string;
  description?: string;
}
const {
  title = 'Ryan Bond | Product Leadership & Customer-Driven Strategy',
  description = 'Ryan Bond: product leader and producer turning customer insight into products, fast. 25 years across ed-tech, health, gaming, advertising and nonprofits.',
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const path = Astro.url.pathname;
const nav = [
  { href: '/work/', label: 'Work' },
  { href: '/about/', label: 'About' },
  { href: '/services/', label: 'Work with me' },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Archivo:wght@700;800&family=Instrument+Sans:wght@400;500;600;700&family=Instrument+Serif:ital@0;1&display=swap" rel="stylesheet" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap header-inner">
        <a class="brand" href="/">
          <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><rect x="1" y="3" width="20" height="20" rx="4" fill="var(--mark)"/><circle cx="19" cy="5" r="4" fill="var(--signal)"/></svg>
          Ryan Bond
        </a>
        <nav aria-label="Main">
          {nav.map((n) => (
            <a href={n.href} aria-current={path.startsWith(n.href) ? 'page' : undefined}>{n.label}</a>
          ))}
        </nav>
        <a class="btn btn-sm" href="mailto:ryanbond@fastmail.net">Get in touch</a>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap footer-inner">
        <p class="brand-foot">Ryan Bond<br /><span>Product leadership, Evanston, Illinois</span></p>
        <ul>
          <li><a href="/work/">Work</a></li>
          <li><a href="/about/">About</a></li>
          <li><a href="/services/">Work with me</a></li>
          <li><a href="https://www.linkedin.com/in/ryanmbond/">LinkedIn</a></li>
          <li><a href="mailto:ryanbond@fastmail.net">ryanbond@fastmail.net</a></li>
        </ul>
        <p class="copy">© {new Date().getFullYear()} Ryan Bond</p>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  /* Tokens from Ryan's personal design system ("Ryan" brand kit) */
  :root {
    --paper: #faf9fc;
    --raised: #ffffff;
    --rule: #e7e3ee;
    --ink: #16121c;
    --ink-muted: #5e5869;
    --signal: #ff3da6;
    --on-signal: #16121c;
    --signal-text: #b3166e;
    --teal: #2ed3c6;
    --stage: #24123a;
    --stage-ink: #f6f3fa;
    --stage-muted: #a79fb4;
    --stage-signal: #ff7ac2;
    --contour: #e3dcec;
    --mark: var(--stage);

    /* semantic roles used by components */
    --bg: var(--paper);
    --surface: var(--raised);
    --text: var(--ink);
    --muted: var(--ink-muted);
    --accent: var(--signal-text);
    --line: var(--rule);
    --pine: var(--stage);        /* strokes, icons, bars */
    --blaze: var(--teal);        /* markers and small highlights */
    --slate: var(--ink-muted);
    --mist: var(--raised);

    --display: 'Archivo', 'Helvetica Neue', Arial, sans-serif;
    --sans: 'Instrument Sans', system-ui, -apple-system, 'Segoe UI', sans-serif;
    --reading: var(--sans);
    --quote: 'Instrument Serif', Georgia, serif;
    --radius: 10px;
    --max: 72rem;
    --measure: 40rem;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --paper: #141019;
      --raised: #201a29;
      --rule: #332b3f;
      --ink: #f6f3fa;
      --ink-muted: #a79fb4;
      --signal-text: #ff7ac2;
      --stage: #3a1d5e;
      --stage-muted: #c2b9cf;
      --contour: #2c2438;
      --pine: #c2b9cf;
      --mark: var(--stage-ink);
    }
  }
  /* Feature sections on the deep-purple stage */
  .on-stage {
    --bg: var(--stage); --surface: color-mix(in srgb, var(--stage) 80%, #000);
    --text: var(--stage-ink); --ink: var(--stage-ink); --muted: var(--stage-muted); --slate: var(--stage-muted);
    --accent: var(--stage-signal); --pine: var(--stage-signal); --paper: var(--stage);
    --line: rgba(246, 243, 250, 0.16); --contour: rgba(246, 243, 250, 0.1);
    background: var(--stage); color: var(--stage-ink);
  }
  *, *::before, *::after { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; }
  body {
    margin: 0; background: var(--bg); color: var(--text);
    font: 400 1.0625rem/1.65 var(--sans);
    -webkit-font-smoothing: antialiased;
  }
  img { max-width: 100%; }
  a { color: var(--accent); text-underline-offset: 0.2em; }
  :focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; border-radius: 4px; }
  h1, h2, h3 { font-family: var(--display); font-weight: 800; line-height: 1.05; letter-spacing: -0.02em; margin: 0 0 0.5em; }
  h3 { font-weight: 700; }
  h1 { font-size: clamp(2.4rem, 6.5vw, 4.5rem); line-height: 0.95; letter-spacing: -0.03em; }
  h2 { font-size: clamp(1.6rem, 3.5vw, 2.25rem); }
  h3 { font-size: 1.25rem; letter-spacing: -0.01em; }
  p { margin: 0 0 1em; }

  .wrap { max-width: var(--max); margin: 0 auto; padding: 0 1.25rem; }
  main { max-width: var(--max); margin: 0 auto; padding: 0 1.25rem; }
  .skip { position: absolute; left: -999px; }
  .skip:focus { left: 1rem; top: 1rem; background: var(--paper); padding: 0.5rem 1rem; z-index: 10; }

  /* A small label in pine, sentence case: used only where it tells you what kind of thing follows */
  .kicker { font-size: 0.75rem; line-height: 1.35; text-transform: uppercase; letter-spacing: 0.08em; font-weight: 600; color: var(--accent); margin: 0 0 0.9rem; }
  .pull { font-family: var(--quote); font-style: italic; font-size: clamp(1.6rem, 3.5vw, 2.15rem); line-height: 1.2; }
  .reading { font-family: var(--reading); }
  .lede { font-family: var(--sans); font-size: clamp(1.1rem, 2vw, 1.25rem); line-height: 1.6; color: var(--muted); max-width: var(--measure); }

  .btn {
    display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.8rem 1.3rem; border-radius: var(--radius);
    font-weight: 600; text-decoration: none; border: 1.5px solid var(--text); color: var(--text); line-height: 1.2;
  }
  .btn:hover { background: var(--surface); }
  .btn-primary { background: var(--signal); border-color: var(--signal); color: var(--on-signal); }
  .btn-primary:hover { background: color-mix(in srgb, var(--signal) 88%, #000); }
  .btn-light { background: var(--stage-ink); border-color: var(--stage-ink); color: var(--stage); }
  .btn-light:hover { background: color-mix(in srgb, var(--stage-ink) 88%, var(--stage)); }
  .btn-sm { padding: 0.5rem 0.9rem; font-size: 0.95rem; }

  /* Header */
  .site-header { border-bottom: 1px solid var(--line); background: var(--bg); }
  .header-inner { display: flex; align-items: center; gap: 1.5rem; padding-top: 1rem; padding-bottom: 1rem; flex-wrap: wrap; }
  .brand { display: inline-flex; align-items: center; gap: 0.55rem; font-family: var(--display); font-weight: 800; font-size: 1.2rem; letter-spacing: -0.02em; color: var(--text); text-decoration: none; }
    .site-header nav { display: flex; gap: 1.5rem; margin-left: auto; }
  .site-header nav a { color: var(--text); text-decoration: none; font-weight: 500; padding: 0.25rem 0; border-bottom: 2px solid transparent; }
  .site-header nav a:hover, .site-header nav a[aria-current='page'] { border-bottom-color: var(--signal); }
  @media (max-width: 44rem) {
    .header-inner { gap: 0.75rem 1rem; }
    .site-header .btn { margin-left: auto; }
    .site-header nav { order: 3; width: 100%; margin-left: 0; gap: 1.25rem; }
  }

  /* Footer */
  .site-footer { border-top: 1px solid var(--line); margin-top: 5rem; background: var(--surface); }
  .footer-inner { display: grid; grid-template-columns: 1fr auto; gap: 1.5rem; padding-top: 2.5rem; padding-bottom: 2.5rem; color: var(--muted); font-size: 0.95rem; }
  .brand-foot { color: var(--text); font-family: var(--display); font-weight: 800; margin: 0; }
  .brand-foot span { color: var(--muted); font-weight: 400; }
  .footer-inner ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.5rem 1.5rem; justify-content: flex-end; }
  .footer-inner a { color: var(--text); text-decoration: none; }
  .footer-inner a:hover { color: var(--accent); }
  .copy { grid-column: 1 / -1; margin: 0; font-size: 0.85rem; }
  @media (max-width: 44rem) { .footer-inner { grid-template-columns: 1fr; } .footer-inner ul { justify-content: flex-start; } }

  /* Long-form reading */
  .prose { font-family: var(--sans); font-size: 1.1rem; line-height: 1.7; max-width: var(--measure); }
  .prose p, .prose li { color: var(--text); }
  .prose h2 { font-family: var(--display); font-size: 1.5rem; margin-top: 2.5rem; }
  .prose h3 { font-family: var(--display); font-size: 1.2rem; margin-top: 1.75rem; }
  .prose strong { font-weight: 600; }
  .prose img { max-width: 100%; height: auto; border-radius: var(--radius); border: 1px solid var(--line); display: block; }
  .prose figure { margin: 2rem 0; }
  .prose figcaption { color: var(--muted); font-family: var(--display); font-size: 0.85rem; margin-top: 0.5rem; }
  .prose .video { position: relative; aspect-ratio: 16 / 9; margin: 2rem 0; border-radius: var(--radius); overflow: hidden; background: var(--line); }
  .prose .video iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  .prose .tags { font-family: var(--display); color: var(--accent); font-weight: 600; font-size: 0.95rem; }
  .prose table { width: 100%; border-collapse: collapse; font-size: 0.95rem; display: block; overflow-x: auto; }
  .prose td, .prose th { border-bottom: 1px solid var(--line); padding: 0.5rem; text-align: left; }
  .btn-inline { display: inline-block; background: var(--signal); color: var(--on-signal); padding: 0.8rem 1.3rem; border-radius: var(--radius); text-decoration: none; font-family: var(--display); font-weight: 600; margin-top: 1rem; }

  @media (prefers-reduced-motion: reduce) { *, *::before, *::after { animation: none !important; transition: none !important; } }
</style>
