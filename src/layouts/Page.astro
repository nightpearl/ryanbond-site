---
import Base from './Base.astro';
interface Props { title: string; eyebrow: string; heading: string; description?: string; }
const { title, eyebrow, heading, description } = Astro.props;
---
<Base title={title} description={description}>
  <article class="page">
    <p class="eyebrow">{eyebrow}</p>
    <h1>{heading}</h1>
    <div class="prose"><slot /></div>
  </article>
</Base>

<style>
  .page { max-width: 44rem; padding: 3rem 0 1rem; }
  .eyebrow { text-transform: uppercase; letter-spacing: 0.08em; font-size: 0.8rem; font-weight: 600; color: var(--accent); margin: 0 0 0.75rem; }
  h1 { font-size: clamp(2rem, 5vw, 3rem); }
</style>
