---
import Base from './Base.astro';
interface Props { title: string; eyebrow: string; heading: string; description?: string; }
const { title, eyebrow, heading, description } = Astro.props;
---
<Base title={title} description={description}>
  <article class="page">
    <p class="kicker">{eyebrow}</p>
    <h1>{heading}</h1>
    <div class="prose"><slot /></div>
  </article>
</Base>

<style>
  .page { padding: 3.5rem 0 1rem; }
  h1 { max-width: 16ch; }
</style>
